generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  googleSub       String          @unique
  email           String          @unique
  name            String
  goalMarathonSec Int?
  goalHalfSec     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        Session[]
  trainingPlans   TrainingPlan[]
  actualWorkouts ActualWorkout[]   

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model TrainingPlan {
  id           String           @id @default(cuid())
  userId       String
  name         String
  goalRaceType String           // "marathon" | "half_marathon" | "10k" | "5k"
  goalTimeSec  Int
  vdot         Int              // snapshot: 計算當下的 VDOT
  status       String           @default("active")  // "active" | "completed" | "archived"
  weeksTotal   Int              @default(8)
  startDate    DateTime?        // 計畫開始日，null = 還沒按開始
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedWorkouts  PlannedWorkout[]
  actualWorkouts  ActualWorkout[]

  @@index([userId])
  @@index([userId, status])
  @@map("training_plans")
}

model PlannedWorkout {
  id                String   @id @default(cuid())
  planId            String
  weekNumber        Int                // 1〜8
  dayOfWeek         Int                // 0=週日, 1=週一, ..., 6=週六
  workoutType       String             // "easy" | "marathon" | "tempo" | "interval" | "repetition" | "long" | "rest" | "cross"
  targetPaceSec     Int?               // 目標配速（秒/km），null 表示這次訓練不指定配速
  targetDistanceKm  Float?             // 目標距離（公里），null 表示這次訓練不以距離為主
  targetDurationSec Int?               // 目標時間（秒），null 表示這次訓練不以時間為主
  warmupKm         Float?  
  cooldownKm       Float?   
  intervals        Json? 
  notes             String?
  createdAt         DateTime @default(now())

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  actualWorkouts ActualWorkout[]

  @@index([planId])
  @@index([planId, weekNumber])
  @@map("planned_workouts")
}

model ActualWorkout {
  id                String   @id @default(cuid())
  userId            String
  plannedWorkoutId  String?
  planId            String?
  date              DateTime
  workoutType       String
  actualDistanceKm  Float
  actualDurationSec Int
  actualPaceSec     Int?
  avgHeartRate      Int?
  maxHeartRate      Int?
  rpe               Int?
  weather           String?
  temperatureC      Float?
  feeling           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedWorkout PlannedWorkout? @relation(fields: [plannedWorkoutId], references: [id], onDelete: SetNull)
  plan           TrainingPlan?   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([planId])
  @@index([plannedWorkoutId])
  @@map("actual_workouts")
}